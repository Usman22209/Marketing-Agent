NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. n8n Automation (Optional - 15-day free trial or cloud)
# Import n8n/autopilot_marketing_gmail.json into your n8n instance
NEXT_PUBLIC_N8N_WEBHOOK_URL=
USER_GMAIL=
