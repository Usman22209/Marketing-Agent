# =========================================================
# AI Marketing Agent Platform - Free Configuration
# =========================================================

# 1. Google Gemini API Key (100% Free - https://aistudio.google.com/)
NEXT_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=

# 2. Supabase Free Database (Optional - https://supabase.com/)
# If left empty, local browser storage is automatically used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Autonomous Cron Job & Timed Event Server
# Optional secret token to protect /api/cron endpoint (leave empty for open/local dev)
CRON_SECRET=
USER_GMAIL=
NEXT_PUBLIC_USER_GMAIL=

# 4. Optional Resend API for Direct Automated Email Delivery (https://resend.com)
RESEND_API_KEY=
