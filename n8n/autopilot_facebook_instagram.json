{
  "name": "AI Marketing Autopilot - Auto Post to Facebook & Instagram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 2
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 2 Days at 10:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-social-post",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "On-Demand Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        500
      ],
      "webhookId": "publish-social-post"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{$env.FACEBOOK_PAGE_ID || $json.body?.pageId}}/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{$json.body?.imageUrl || 'https://via.placeholder.com/1080'}}"
            },
            {
              "name": "caption",
              "value": "={{$json.body?.caption || $json.body?.linkedinPost}}"
            },
            {
              "name": "access_token",
              "value": "={{$env.META_PAGE_ACCESS_TOKEN || $json.body?.accessToken}}"
            }
          ]
        },
        "options": {}
      },
      "id": "facebook-publish-node",
      "name": "Publish to Facebook Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        550,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{$env.INSTAGRAM_ACCOUNT_ID || $json.body?.instagramAccountId}}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{$json.body?.imageUrl || 'https://via.placeholder.com/1080'}}"
            },
            {
              "name": "caption",
              "value": "={{$json.body?.instagramCaption || $json.body?.caption}} {{$json.body?.hashtags?.join(' ') || ''}}"
            },
            {
              "name": "access_token",
              "value": "={{$env.META_PAGE_ACCESS_TOKEN || $json.body?.accessToken}}"
            }
          ]
        },
        "options": {}
      },
      "id": "instagram-create-container",
      "name": "Instagram: 1. Create Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        550,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{$env.INSTAGRAM_ACCOUNT_ID || $json.body?.instagramAccountId}}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{$json.id}}"
            },
            {
              "name": "access_token",
              "value": "={{$env.META_PAGE_ACCESS_TOKEN || $json.body?.accessToken}}"
            }
          ]
        },
        "options": {}
      },
      "id": "instagram-publish-container",
      "name": "Instagram: 2. Publish Post Live",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        500
      ]
    }
  ],
  "connections": {
    "Every 2 Days at 10:00 AM": {
      "main": [
        [
          {
            "node": "Publish to Facebook Page",
            "type": "main",
            "index": 0
          },
          {
            "node": "Instagram: 1. Create Media Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On-Demand Webhook Trigger": {
      "main": [
        [
          {
            "node": "Publish to Facebook Page",
            "type": "main",
            "index": 0
          },
          {
            "node": "Instagram: 1. Create Media Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram: 1. Create Media Container": {
      "main": [
        [
          {
            "node": "Instagram: 2. Publish Post Live",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
